# Local-only defaults. Real values must be injected outside the repository.
MINGLI_ENVIRONMENT=local
MINGLI_DATABASE_URL=postgresql+asyncpg://mingli:mingli-local@127.0.0.1:5432/mingli
MINGLI_COOKIE_SECURE=false
# OTP delivery adapter: fake | disabled | smtp
MINGLI_OTP_ADAPTER=fake
MINGLI_FAKE_OTP_CODE=246810
MINGLI_OTP_RATE_WINDOW_SECONDS=600
MINGLI_OTP_GUEST_WINDOW_LIMIT=5
MINGLI_OTP_NETWORK_WINDOW_LIMIT=30
# Rolling OTP limit per normalized destination hash, shared across guests.
MINGLI_OTP_DESTINATION_WINDOW_LIMIT=5
# Guest-session creation window per client IP (trusted-proxy aware).
MINGLI_GUEST_SESSION_CREATE_RATE_LIMIT=10
MINGLI_GUEST_SESSION_CREATE_RATE_WINDOW_SECONDS=600
# Optional staging SMTP delivery. Never put real credentials in this file;
# inject them at deploy time. Plaintext is never allowed.
# MINGLI_SMTP_HOST=smtp.example.com
# MINGLI_SMTP_PORT=587
# MINGLI_SMTP_SECURITY=starttls   # starttls | ssl
# MINGLI_SMTP_USERNAME=
# MINGLI_SMTP_PASSWORD=
# MINGLI_SMTP_SENDER=no-reply@example.com
MINGLI_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
MINGLI_IDENTITY_HASH_KEY=local-only-identity-hash-key-change-in-production
