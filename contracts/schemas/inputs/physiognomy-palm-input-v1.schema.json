{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fateradar.cn/contracts/inputs/physiognomy-palm-input-v1.schema.json",
  "title": "Physiognomy Palm Input v1",
  "description": "Formal intake for 见相 palm scope only. v1 accepts user-transcribed visible observations of classical 手足/掌/五指/手背 regions. Western life/head/heart/fate lines, posture, combined, face regions, raw images, and luck fields are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "observations"],
  "properties": {
    "schema_version": {"const": "physiognomy-palm-input/v1"},
    "mode": {"const": "palm"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/observation"}
    },
    "region_label": {
      "type": ["string", "null"],
      "pattern": "^[\\u3400-\\u9FFF\\uF900-\\uFAFF]{1,8}$"
    },
    "subject_ref": {
      "type": ["string", "null"],
      "minLength": 1
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "descriptor", "visibility", "uncertainty"],
      "properties": {
        "region_id": {
          "enum": [
            "left_hand",
            "right_hand",
            "left_palm",
            "right_palm",
            "fingers",
            "hand_back"
          ]
        },
        "descriptor": {
          "enum": [
            "region_visible",
            "contour_visible",
            "texture_even_visible",
            "pattern_visible",
            "nail_visible"
          ]
        },
        "visibility": {"enum": ["full", "partial"]},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
