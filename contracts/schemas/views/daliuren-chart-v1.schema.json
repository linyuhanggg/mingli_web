{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fateradar.cn/contracts/views/daliuren-chart-v1.schema.json", "title": "Daliuren Chart ViewModel v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "subject_ref", "question", "lessons", "transmissions"],
  "properties": {
    "schema_version": {"const": "daliuren-chart/v1"}, "subject_ref": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1},
    "lessons": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["lesson_id", "upper", "lower"], "properties": {"lesson_id": {"type": "string", "minLength": 1}, "upper": {"type": "string", "minLength": 1}, "lower": {"type": "string", "minLength": 1}}}},
    "transmissions": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "branch", "general"], "properties": {"stage": {"enum": ["initial", "middle", "final"]}, "branch": {"type": "string", "minLength": 1}, "general": {"type": "string", "minLength": 1}}}},
    "core_facts": {"oneOf": [{"$ref": "#/$defs/coreFacts"}, {"type": "null"}]}
  },
  "$defs": {
    "coreFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "day_hour": {"type": ["object", "null"]},
        "dimension_facts": {"type": ["object", "null"]},
        "earth_plate": {"type": ["array", "null"], "items": {"type": "string"}},
        "heaven_plate": {"type": ["array", "null"], "items": {"type": "object"}},
        "heavenly_generals": {"type": ["array", "null"], "items": {"type": "object"}},
        "lesson_method": {"type": ["object", "null"]},
        "month_general": {"type": ["object", "null"]},
        "noble_person": {"type": ["object", "null"]},
        "plate_offset": {"type": ["integer", "null"]},
        "structural_patterns": {"type": ["array", "null"], "items": {"type": "string"}},
        "transmission_method": {"type": ["object", "null"]},
        "timing_candidates": {"type": ["array", "null"], "items": {"$ref": "#/$defs/timingCandidate"}},
        "xunkong": {"type": ["object", "null"]}
      }
    },
    "timingCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "anchor_earth_branch", "branch", "solar_date", "day_ganzhi", "days_after_cast", "source_pack", "source_rule", "candidate_not_guarantee"],
      "properties": {
        "id": {"const": "initial_group_upper_candidate"},
        "role": {"const": "event_response_candidate"},
        "anchor_earth_branch": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "solar_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "day_ganzhi": {"type": "string", "minLength": 2},
        "days_after_cast": {"type": "integer", "minimum": 1, "maximum": 12},
        "source_pack": {"type": "string", "minLength": 1},
        "source_rule": {"const": "LM-R21"},
        "candidate_not_guarantee": {"const": true}
      }
    }
  }
}
