{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fateradar.cn/contracts/views/bazi-chart-v1.schema.json",
  "title": "Bazi Chart ViewModel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_ref", "pillars", "element_balance", "time_layers"],
  "properties": {
    "schema_version": {"const": "bazi-chart/v1"},
    "subject_ref": {"type": "string", "minLength": 1},
    "pillars": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/pillar"}},
    "element_balance": {"type": "array", "items": {"$ref": "#/$defs/elementBalance"}},
    "time_layers": {"type": "array", "items": {"$ref": "#/$defs/timeLayer"}},
    "core_facts": {"oneOf": [{"$ref": "#/$defs/coreFacts"}, {"type": "null"}]}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "stringArray": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "position": {"enum": ["year", "month", "day", "hour"]},
    "element": {"enum": ["wood", "fire", "earth", "metal", "water"]},
    "pillar": {"type": "object", "additionalProperties": false, "required": ["position", "stem", "branch"], "properties": {"position": {"$ref": "#/$defs/position"}, "stem": {"$ref": "#/$defs/text"}, "branch": {"$ref": "#/$defs/text"}}},
    "elementBalance": {"type": "object", "additionalProperties": false, "required": ["element", "value", "display_text"], "properties": {"element": {"$ref": "#/$defs/element"}, "value": {"type": "number"}, "display_text": {"$ref": "#/$defs/text"}}},
    "timeLayer": {"type": "object", "additionalProperties": false, "required": ["layer_id", "label", "available", "unavailable_reason"], "properties": {"layer_id": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "available": {"type": "boolean"}, "unavailable_reason": {"type": ["string", "null"], "minLength": 1}}, "allOf": [{"if": {"properties": {"available": {"const": true}}}, "then": {"properties": {"unavailable_reason": {"type": "null"}}}, "else": {"properties": {"unavailable_reason": {"type": "string", "minLength": 1}}}}]},
    "dayMaster": {"type": "object", "additionalProperties": false, "required": ["stem", "element", "polarity"], "properties": {"stem": {"$ref": "#/$defs/text"}, "element": {"$ref": "#/$defs/element"}, "polarity": {"enum": ["阳", "阴"]}}},
    "hiddenStems": {"type": "object", "additionalProperties": false, "required": ["position", "branch", "stems"], "properties": {"position": {"$ref": "#/$defs/position"}, "branch": {"$ref": "#/$defs/text"}, "stems": {"$ref": "#/$defs/stringArray", "minItems": 1}}},
    "tenGodEntry": {"type": "object", "additionalProperties": false, "required": ["position", "layer", "stem", "ten_god"], "properties": {"position": {"$ref": "#/$defs/position"}, "layer": {"enum": ["heavenly_stem", "hidden_stem"]}, "stem": {"$ref": "#/$defs/text"}, "ten_god": {"$ref": "#/$defs/text"}}},
    "tenGods": {"type": "object", "additionalProperties": false, "required": ["heavenly_stems", "hidden_stems"], "properties": {"heavenly_stems": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/tenGodEntry"}}, "hidden_stems": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tenGodEntry"}}}},
    "nayin": {"type": "object", "additionalProperties": false, "required": ["position", "name"], "properties": {"position": {"$ref": "#/$defs/position"}, "name": {"$ref": "#/$defs/text"}}},
    "monthCommand": {"type": "object", "additionalProperties": false, "required": ["branch", "label", "main_qi", "main_qi_element"], "properties": {"branch": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "main_qi": {"$ref": "#/$defs/text"}, "main_qi_element": {"$ref": "#/$defs/element"}}},
    "seasonalProfile": {"type": "object", "additionalProperties": false, "required": ["season", "month_qi", "temperature", "moisture"], "properties": {"season": {"$ref": "#/$defs/text"}, "month_qi": {"$ref": "#/$defs/text"}, "temperature": {"$ref": "#/$defs/text"}, "moisture": {"$ref": "#/$defs/text"}}},
    "tiaohou": {"type": "object", "additionalProperties": false, "required": ["temperature", "moisture", "markers", "scope"], "properties": {"temperature": {"$ref": "#/$defs/text"}, "moisture": {"$ref": "#/$defs/text"}, "markers": {"$ref": "#/$defs/stringArray", "minItems": 1}, "day_stem": {"type": ["string", "null"], "minLength": 1}, "month_branch": {"type": ["string", "null"], "minLength": 1}, "scope": {"$ref": "#/$defs/text"}}},
    "elementCount": {"type": "object", "additionalProperties": false, "required": ["element", "value"], "properties": {"element": {"$ref": "#/$defs/element"}, "value": {"type": "integer", "minimum": 0}}},
    "elementInventory": {"type": "object", "additionalProperties": false, "required": ["visible_stem_branch_counts", "hidden_stem_occurrence_counts", "scope"], "properties": {"visible_stem_branch_counts": {"type": "array", "items": {"$ref": "#/$defs/elementCount"}}, "hidden_stem_occurrence_counts": {"type": "array", "items": {"$ref": "#/$defs/elementCount"}}, "scope": {"$ref": "#/$defs/text"}}},
    "strengthEvidence": {"type": "object", "additionalProperties": false, "required": ["status", "hard_verdict", "day_element", "month_command_element", "same_element_occurrences", "resource_element", "resource_occurrences", "all_element_occurrences", "boundary"], "properties": {"status": {"const": "evidence_only"}, "hard_verdict": {"type": "null"}, "day_element": {"$ref": "#/$defs/element"}, "month_command_element": {"$ref": "#/$defs/element"}, "same_element_occurrences": {"type": "integer", "minimum": 0}, "resource_element": {"$ref": "#/$defs/element"}, "resource_occurrences": {"type": "integer", "minimum": 0}, "all_element_occurrences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/elementCount"}}, "boundary": {"$ref": "#/$defs/text"}}},
    "structureCandidate": {"type": "object", "additionalProperties": false, "required": ["status", "hard_verdict", "month_main_qi", "month_main_qi_ten_god", "main_qi_visible", "visible_positions", "boundary"], "properties": {"status": {"const": "candidate_only"}, "hard_verdict": {"type": "null"}, "month_main_qi": {"$ref": "#/$defs/text"}, "month_main_qi_ten_god": {"$ref": "#/$defs/text"}, "main_qi_visible": {"type": "boolean"}, "visible_positions": {"$ref": "#/$defs/stringArray"}, "boundary": {"$ref": "#/$defs/text"}}},
    "stemCombinationCandidate": {"type": "object", "additionalProperties": false, "required": ["with_position", "stems", "candidate_element", "status"], "properties": {"with_position": {"$ref": "#/$defs/text"}, "stems": {"$ref": "#/$defs/stringArray", "minItems": 1}, "candidate_element": {"$ref": "#/$defs/element"}, "status": {"$ref": "#/$defs/text"}}},
    "followingTransformation": {"type": "object", "additionalProperties": false, "required": ["status", "hard_verdict", "stem_combination_candidates", "branch_formation_candidates", "boundary"], "properties": {"status": {"const": "requires_classical_adjudication"}, "hard_verdict": {"type": "null"}, "stem_combination_candidates": {"type": "array", "items": {"$ref": "#/$defs/stemCombinationCandidate"}}, "branch_formation_candidates": {"type": "array", "items": {"$ref": "#/$defs/branchRelation"}}, "boundary": {"$ref": "#/$defs/text"}}},
    "salienceSignal": {"type": "object", "additionalProperties": false, "required": ["signal_id", "status", "hard_verdict", "basis", "boundary"], "properties": {"signal_id": {"$ref": "#/$defs/text"}, "status": {"const": "mechanical_candidate"}, "hard_verdict": {"type": "null"}, "basis": {"type": "object"}, "boundary": {"$ref": "#/$defs/text"}}},
    "reasoningTool": {"type": "object", "additionalProperties": false, "required": ["schema_version", "tool_id", "tool_kind", "confidence_bucket", "confidence_ceiling", "visibility_class", "fact_refs", "source_refs", "output", "caveats", "tool_digest"], "properties": {"schema_version": {"$ref": "#/$defs/text"}, "tool_id": {"$ref": "#/$defs/text"}, "tool_kind": {"$ref": "#/$defs/text"}, "confidence_bucket": {"enum": ["low", "medium", "high"]}, "confidence_ceiling": {"enum": ["low", "medium", "high"]}, "visibility_class": {"enum": ["auto_injected", "on_demand", "translated", "trigger_only"]}, "fact_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "output": {"type": "object"}, "caveats": {"$ref": "#/$defs/stringArray", "minItems": 1}, "tool_digest": {"$ref": "#/$defs/text"}}},
    "interpretiveCandidates": {"type": "object", "additionalProperties": false, "required": ["strength", "structure", "following_and_transformation", "salience_signals"], "properties": {"strength": {"$ref": "#/$defs/strengthEvidence"}, "structure": {"$ref": "#/$defs/structureCandidate"}, "following_and_transformation": {"$ref": "#/$defs/followingTransformation"}, "salience_signals": {"type": "array", "items": {"$ref": "#/$defs/salienceSignal"}}, "reasoning_tools": {"oneOf": [{"type": "object", "additionalProperties": {"$ref": "#/$defs/reasoningTool"}}, {"type": "null"}]}}},
    "branchRelation": {"type": "object", "additionalProperties": false, "required": ["relation_type", "positions", "branches"], "properties": {"relation_type": {"$ref": "#/$defs/text"}, "positions": {"$ref": "#/$defs/stringArray"}, "branches": {"$ref": "#/$defs/stringArray", "minItems": 2}}},
    "boundaryTerm": {"type": "object", "additionalProperties": false, "required": ["name", "index", "is_month_boundary_jie", "datetime", "instant_utc"], "properties": {"name": {"$ref": "#/$defs/text"}, "index": {"type": "integer"}, "is_month_boundary_jie": {"type": "boolean"}, "datetime": {"$ref": "#/$defs/text"}, "instant_utc": {"$ref": "#/$defs/text"}}},
    "luckCycle": {"type": "object", "additionalProperties": false, "required": ["sequence", "pillar", "start_age_years", "end_age_years"], "properties": {"sequence": {"type": "integer", "minimum": 1, "maximum": 10}, "pillar": {"type": "string", "minLength": 2}, "start_age_years": {"type": ["number", "null"], "minimum": 0}, "end_age_years": {"type": ["number", "null"], "minimum": 0}}},
    "luckCycles": {"type": "object", "additionalProperties": false, "required": ["status", "direction", "direction_rule", "start_age_rule", "boundary_term", "interval_days", "start_age_years", "approximate_start_datetime", "cycles", "unavailable"], "properties": {"status": {"enum": ["calculated", "sequence_only", "not_calculated_missing_gender"]}, "direction": {"enum": ["forward", "reverse", null]}, "direction_rule": {"type": ["string", "null"], "minLength": 1}, "start_age_rule": {"type": ["string", "null"], "minLength": 1}, "boundary_term": {"oneOf": [{"$ref": "#/$defs/boundaryTerm"}, {"type": "null"}]}, "interval_days": {"type": ["number", "null"], "minimum": 0}, "start_age_years": {"type": ["number", "null"], "minimum": 0}, "approximate_start_datetime": {"type": ["string", "null"], "minLength": 1}, "cycles": {"type": "array", "items": {"$ref": "#/$defs/luckCycle"}}, "unavailable": {"$ref": "#/$defs/stringArray"}}},
    "shenshaRule": {"type": "object", "additionalProperties": false, "required": ["rule_id", "name", "anchor_position", "anchor_branch", "target_branch", "matched"], "properties": {"rule_id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "anchor_position": {"$ref": "#/$defs/text"}, "anchor_branch": {"$ref": "#/$defs/text"}, "target_branch": {"$ref": "#/$defs/text"}, "matched": {"type": "boolean"}}},
    "shenshaItem": {"type": "object", "additionalProperties": false, "required": ["item_id", "name", "target_branch", "anchor_positions", "anchor_branches", "matched_positions", "status"], "properties": {"item_id": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "target_branch": {"$ref": "#/$defs/text"}, "anchor_positions": {"$ref": "#/$defs/stringArray"}, "anchor_branches": {"$ref": "#/$defs/stringArray"}, "matched_positions": {"$ref": "#/$defs/stringArray"}, "status": {"$ref": "#/$defs/text"}}},
    "shensha": {"type": "object", "additionalProperties": false, "required": ["status", "temporal_scope", "precedence", "evaluated_rules", "calculated_items", "cannot_override", "boundary"], "properties": {"status": {"$ref": "#/$defs/text"}, "temporal_scope": {"$ref": "#/$defs/text"}, "precedence": {"$ref": "#/$defs/text"}, "evaluated_rules": {"type": "array", "items": {"$ref": "#/$defs/shenshaRule"}}, "calculated_items": {"type": "array", "items": {"$ref": "#/$defs/shenshaItem"}}, "cannot_override": {"$ref": "#/$defs/stringArray"}, "boundary": {"$ref": "#/$defs/text"}}},
    "coreFacts": {"type": "object", "additionalProperties": false, "properties": {"day_master": {"oneOf": [{"$ref": "#/$defs/dayMaster"}, {"type": "null"}]}, "hidden_stems": {"oneOf": [{"type": "array", "items": {"$ref": "#/$defs/hiddenStems"}}, {"type": "null"}]}, "ten_gods": {"oneOf": [{"$ref": "#/$defs/tenGods"}, {"type": "null"}]}, "nayin": {"oneOf": [{"type": "array", "items": {"$ref": "#/$defs/nayin"}}, {"type": "null"}]}, "month_command": {"oneOf": [{"$ref": "#/$defs/monthCommand"}, {"type": "null"}]}, "seasonal_profile": {"oneOf": [{"$ref": "#/$defs/seasonalProfile"}, {"type": "null"}]}, "tiaohou_markers": {"oneOf": [{"$ref": "#/$defs/tiaohou"}, {"type": "null"}]}, "element_inventory": {"oneOf": [{"$ref": "#/$defs/elementInventory"}, {"type": "null"}]}, "interpretive_candidates": {"oneOf": [{"$ref": "#/$defs/interpretiveCandidates"}, {"type": "null"}]}, "branch_relations": {"oneOf": [{"type": "array", "items": {"$ref": "#/$defs/branchRelation"}}, {"type": "null"}]}, "shensha_auxiliary": {"oneOf": [{"$ref": "#/$defs/shensha"}, {"type": "null"}]}, "luck_cycles": {"oneOf": [{"$ref": "#/$defs/luckCycles"}, {"type": "null"}]}}}
  }
}
