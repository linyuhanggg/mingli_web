{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "vitest/globals"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "/var/folders/0y/h8_0p2m91v1fsjkcs5j74l4w0000gn/T/paperclip-run-cmp-62-ba4d20d4-969-Pz1FAB/next-dist/types/**/*.ts",
    "/var/folders/0y/h8_0p2m91v1fsjkcs5j74l4w0000gn/T/paperclip-run-cmp-62-ba4d20d4-969-Pz1FAB/next-dist/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
