{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fateradar.cn/contracts/views/wenshi-view-v1.schema.json", "title": "Wenshi ViewModel v1",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "subject_ref", "question", "selected_art_ids", "dimensions"],
  "properties": {"schema_version": {"const": "wenshi-view/v1"}, "subject_ref": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "selected_art_ids": {"type": "array", "prefixItems": [{"const": "liuyao"}, {"const": "qimen"}, {"const": "daliuren"}], "items": false, "minItems": 3, "maxItems": 3}, "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}}},
  "$defs": {
    "signal": {"type": "object", "additionalProperties": false, "required": ["art_id", "subject_refs", "signal_id", "display_text", "fact_refs"], "properties": {"art_id": {"enum": ["bazi", "ziwei", "qizheng", "liuyao", "qimen", "daliuren"]}, "subject_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "signal_id": {"type": "string", "minLength": 1}, "display_text": {"type": "string", "minLength": 1}, "fact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "dimension": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "signals", "convergence", "disagreements", "missing_art_ids"], "properties": {"dimension_id": {"type": "string", "minLength": 1}, "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}}, "convergence": {"type": "array", "items": {"type": "string", "minLength": 1}}, "disagreements": {"type": "array", "items": {"type": "string", "minLength": 1}}, "missing_art_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  }
}
