{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fateradar.cn/contracts/views/time-check-view-v1.schema.json",
  "title": "TimeCheckViewV1",
  "description": "Facts-only projection for the twelve-hour time-check candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_ref",
    "candidate_count",
    "candidates",
    "known_time_range",
    "time_basis_policy",
    "known_event_count",
    "event_input_status",
    "candidate_rankings",
    "event_matches",
    "ranking_status",
    "event_matching_status",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "time-check-view/v1"},
    "subject_ref": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 12, "maximum": 12},
    "candidates": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "known_time_range": {"type": "object"},
    "time_basis_policy": {"type": "string", "minLength": 1},
    "known_event_count": {"type": "integer", "minimum": 0},
    "event_input_status": {"enum": ["not_supplied", "invalid_structured_events", "structured_valid"]},
    "candidate_rankings": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidateEvidence"}
    },
    "event_matches": {
      "type": "array",
      "items": {"$ref": "#/$defs/eventMatch"}
    },
    "ranking_status": {"enum": ["not_ranked", "candidate_evidence_ranked"]},
    "event_matching_status": {"enum": ["not_calculated", "structured_evidence"]},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "hour_branch",
        "local_civil_datetime",
        "within_known_time_range",
        "four_pillars",
        "calendar_normalization"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "hour_branch": {"type": "string", "minLength": 1},
        "local_civil_datetime": {"type": "string", "minLength": 1},
        "within_known_time_range": {"type": "boolean"},
        "bazi_chart_digest": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "four_pillars": {},
        "day_master": {},
        "calendar_normalization": {"type": "object"}
      }
    },
    "candidateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "hour_branch",
        "eligible",
        "evidence_score",
        "matched_event_ids",
        "elimination_reasons",
        "event_evidence",
        "rank"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "hour_branch": {"type": "string", "minLength": 1},
        "eligible": {"type": "boolean"},
        "evidence_score": {"type": "integer"},
        "matched_event_ids": {"type": "array", "items": {"type": "string"}},
        "elimination_reasons": {"type": "array", "items": {"type": "string"}},
        "event_evidence": {"type": "array", "items": {"type": "object"}},
        "rank": {"type": "integer", "minimum": 1, "maximum": 12}
      }
    },
    "eventMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "domain", "occurred_at", "year_pillar", "matched_candidate_ids"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "domain": {"enum": ["career", "education", "finance", "relationship", "family", "location", "health"]},
        "occurred_at": {"type": "string", "minLength": 1},
        "year_pillar": {"type": "string", "minLength": 2},
        "matched_candidate_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
