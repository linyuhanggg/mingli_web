{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fateradar.cn/contracts/views/dream-interpretation-view-v1.schema.json",
  "title": "Dream Interpretation ViewModel v1",
  "description": "Facts-only projection for standalone 解梦. Lookup against pinned 《玉匣记》占梦 rows; current recension has an empty table. No luck verdict, Zhou Gong dictionary, LLM prose, psychology, or 六爻/六壬 board 梦寐.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_ref",
    "normalized",
    "omen_match",
    "source_identity",
    "active_source_rule_ids",
    "source_dependency_ids",
    "source_status",
    "source_gaps",
    "limitations",
    "hard_verdict"
  ],
  "properties": {
    "schema_version": {"const": "dream-interpretation-view/v1"},
    "subject_ref": {"$ref": "#/$defs/text"},
    "normalized": {"$ref": "#/$defs/normalizedDream"},
    "omen_match": {
      "oneOf": [
        {"$ref": "#/$defs/omenMatch"},
        {"type": "null"}
      ]
    },
    "source_identity": {"$ref": "#/$defs/sourceIdentity"},
    "active_source_rule_ids": {"$ref": "#/$defs/stringArray"},
    "source_dependency_ids": {"$ref": "#/$defs/stringArray"},
    "source_status": {
      "enum": [
        "exact_rule_bound",
        "ambiguous",
        "unmatched",
        "unavailable"
      ]
    },
    "source_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/text"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/text"}
    },
    "hard_verdict": {"type": "null"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "stringArray": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "normalizedDream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dream_text", "omen_key", "script"],
      "properties": {
        "dream_text": {"$ref": "#/$defs/text"},
        "omen_key": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "script": {"const": "hanzi"}
      }
    },
    "omenMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookup_key",
        "match_status",
        "source_rule_id",
        "source_excerpt"
      ],
      "properties": {
        "lookup_key": {"$ref": "#/$defs/text"},
        "match_status": {"enum": ["exact", "ambiguous", "unmatched"]},
        "source_rule_id": {"$ref": "#/$defs/text"},
        "source_excerpt": {"$ref": "#/$defs/text"}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_pack",
        "source_dependency_id",
        "source_rule_id",
        "source_anchor"
      ],
      "properties": {
        "source_pack": {"const": "selection/yuqia-ji"},
        "source_dependency_id": {"$ref": "#/$defs/text"},
        "source_rule_id": {"$ref": "#/$defs/text"},
        "source_anchor": {"$ref": "#/$defs/text"}
      }
    }
  }
}
