{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fateradar.cn/contracts/views/five-elements-facts-view-v1.schema.json",
  "title": "Five Elements Facts ViewModel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_ref", "day_master", "month_command", "seasonal_profile", "tiaohou_markers", "element_inventory", "interpretive_candidates", "source_identity", "active_source_rule_ids", "source_dependency_ids", "source_status", "source_gaps", "limitations"],
  "properties": {
    "schema_version": {"const": "five-elements-facts-view/v1"},
    "subject_ref": {"type": "string", "minLength": 1},
    "day_master": {"oneOf": [{"$ref": "#/$defs/dayMaster"}, {"type": "null"}]},
    "month_command": {"oneOf": [{"$ref": "#/$defs/monthCommand"}, {"type": "null"}]},
    "seasonal_profile": {"oneOf": [{"$ref": "#/$defs/seasonalProfile"}, {"type": "null"}]},
    "tiaohou_markers": {"oneOf": [{"$ref": "#/$defs/tiaohou"}, {"type": "null"}]},
    "element_inventory": {"oneOf": [{"$ref": "#/$defs/elementInventory"}, {"type": "null"}]},
    "interpretive_candidates": {"oneOf": [{"$ref": "#/$defs/interpretiveCandidates"}, {"type": "null"}]},
    "source_identity": {"oneOf": [{"$ref": "#/$defs/sourceIdentity"}, {"type": "null"}]},
    "active_source_rule_ids": {"$ref": "#/$defs/stringArray"},
    "source_dependency_ids": {"$ref": "#/$defs/stringArray"},
    "source_status": {"enum": ["exact_rule_bound", "identity_only", "unavailable"]},
    "source_gaps": {"$ref": "#/$defs/stringArray"},
    "limitations": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "stringArray": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "element": {"enum": ["wood", "fire", "earth", "metal", "water"]},
    "dayMaster": {"type": "object", "additionalProperties": false, "required": ["stem", "element", "polarity"], "properties": {"stem": {"$ref": "#/$defs/text"}, "element": {"$ref": "#/$defs/element"}, "polarity": {"enum": ["阳", "阴"]}}},
    "monthCommand": {"type": "object", "additionalProperties": false, "required": ["branch", "label", "main_qi", "main_qi_element"], "properties": {"branch": {"$ref": "#/$defs/text"}, "label": {"$ref": "#/$defs/text"}, "main_qi": {"$ref": "#/$defs/text"}, "main_qi_element": {"$ref": "#/$defs/element"}}},
    "seasonalProfile": {"type": "object", "additionalProperties": false, "required": ["season", "month_qi", "temperature", "moisture"], "properties": {"season": {"$ref": "#/$defs/text"}, "month_qi": {"$ref": "#/$defs/text"}, "temperature": {"$ref": "#/$defs/text"}, "moisture": {"$ref": "#/$defs/text"}}},
    "tiaohou": {"type": "object", "additionalProperties": false, "required": ["temperature", "moisture", "markers", "scope"], "properties": {"temperature": {"$ref": "#/$defs/text"}, "moisture": {"$ref": "#/$defs/text"}, "markers": {"$ref": "#/$defs/stringArray"}, "day_stem": {"type": ["string", "null"], "minLength": 1}, "month_branch": {"type": ["string", "null"], "minLength": 1}, "scope": {"$ref": "#/$defs/text"}}},
    "elementCount": {"type": "object", "additionalProperties": false, "required": ["element", "value"], "properties": {"element": {"$ref": "#/$defs/element"}, "value": {"type": "integer", "minimum": 0}}},
    "elementInventory": {"type": "object", "additionalProperties": false, "required": ["visible_stem_branch_counts", "hidden_stem_occurrence_counts", "scope"], "properties": {"visible_stem_branch_counts": {"type": "array", "items": {"$ref": "#/$defs/elementCount"}}, "hidden_stem_occurrence_counts": {"type": "array", "items": {"$ref": "#/$defs/elementCount"}}, "scope": {"$ref": "#/$defs/text"}}},
    "strengthEvidence": {"type": "object", "additionalProperties": false, "required": ["status", "hard_verdict", "day_element", "month_command_element", "same_element_occurrences", "resource_element", "resource_occurrences", "all_element_occurrences", "boundary"], "properties": {"status": {"const": "evidence_only"}, "hard_verdict": {"type": "null"}, "day_element": {"$ref": "#/$defs/element"}, "month_command_element": {"$ref": "#/$defs/element"}, "same_element_occurrences": {"type": "integer", "minimum": 0}, "resource_element": {"$ref": "#/$defs/element"}, "resource_occurrences": {"type": "integer", "minimum": 0}, "all_element_occurrences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/elementCount"}}, "boundary": {"$ref": "#/$defs/text"}}},
    "structureCandidate": {"type": "object", "additionalProperties": false, "required": ["status", "hard_verdict", "month_main_qi", "month_main_qi_ten_god", "main_qi_visible", "visible_positions", "boundary"], "properties": {"status": {"const": "candidate_only"}, "hard_verdict": {"type": "null"}, "month_main_qi": {"$ref": "#/$defs/text"}, "month_main_qi_ten_god": {"$ref": "#/$defs/text"}, "main_qi_visible": {"type": "boolean"}, "visible_positions": {"$ref": "#/$defs/stringArray"}, "boundary": {"$ref": "#/$defs/text"}}},
    "stemCombinationCandidate": {"type": "object", "additionalProperties": false, "required": ["with_position", "stems", "candidate_element", "status"], "properties": {"with_position": {"$ref": "#/$defs/text"}, "stems": {"$ref": "#/$defs/stringArray", "minItems": 1}, "candidate_element": {"$ref": "#/$defs/element"}, "status": {"$ref": "#/$defs/text"}}},
    "branchRelation": {"type": "object", "additionalProperties": false, "required": ["relation_type", "positions", "branches"], "properties": {"relation_type": {"$ref": "#/$defs/text"}, "positions": {"$ref": "#/$defs/stringArray"}, "branches": {"$ref": "#/$defs/stringArray", "minItems": 2}}},
    "followingTransformation": {"type": "object", "additionalProperties": false, "required": ["status", "hard_verdict", "stem_combination_candidates", "branch_formation_candidates", "boundary"], "properties": {"status": {"const": "requires_classical_adjudication"}, "hard_verdict": {"type": "null"}, "stem_combination_candidates": {"type": "array", "items": {"$ref": "#/$defs/stemCombinationCandidate"}}, "branch_formation_candidates": {"type": "array", "items": {"$ref": "#/$defs/branchRelation"}}, "boundary": {"$ref": "#/$defs/text"}}},
    "salienceSignal": {"type": "object", "additionalProperties": false, "required": ["signal_id", "status", "hard_verdict", "basis", "boundary"], "properties": {"signal_id": {"$ref": "#/$defs/text"}, "status": {"const": "mechanical_candidate"}, "hard_verdict": {"type": "null"}, "basis": {"type": "object"}, "boundary": {"$ref": "#/$defs/text"}}},
    "reasoningTool": {"type": "object", "additionalProperties": false, "required": ["schema_version", "tool_id", "tool_kind", "confidence_bucket", "confidence_ceiling", "visibility_class", "fact_refs", "source_refs", "output", "caveats", "tool_digest"], "properties": {"schema_version": {"$ref": "#/$defs/text"}, "tool_id": {"$ref": "#/$defs/text"}, "tool_kind": {"$ref": "#/$defs/text"}, "confidence_bucket": {"enum": ["low", "medium", "high"]}, "confidence_ceiling": {"enum": ["low", "medium", "high"]}, "visibility_class": {"enum": ["auto_injected", "on_demand", "translated", "trigger_only"]}, "fact_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "output": {"type": "object"}, "caveats": {"$ref": "#/$defs/stringArray", "minItems": 1}, "tool_digest": {"$ref": "#/$defs/text"}}},
    "interpretiveCandidates": {"type": "object", "additionalProperties": false, "required": ["strength", "structure", "following_and_transformation", "salience_signals"], "properties": {"strength": {"$ref": "#/$defs/strengthEvidence"}, "structure": {"$ref": "#/$defs/structureCandidate"}, "following_and_transformation": {"$ref": "#/$defs/followingTransformation"}, "salience_signals": {"type": "array", "items": {"$ref": "#/$defs/salienceSignal"}}, "reasoning_tools": {"oneOf": [{"type": "object", "additionalProperties": {"$ref": "#/$defs/reasoningTool"}}, {"type": "null"}]}}},
    "sourceIdentity": {"type": "object", "additionalProperties": false, "required": ["day_stem", "month_branch", "source_dependency_id", "source_section_id", "source_rule_id"], "properties": {"day_stem": {"type": ["string", "null"], "minLength": 1}, "month_branch": {"type": ["string", "null"], "minLength": 1}, "source_dependency_id": {"type": ["string", "null"], "minLength": 1}, "source_section_id": {"type": ["string", "null"], "minLength": 1}, "source_rule_id": {"type": ["string", "null"], "minLength": 1}}}
  }
}
