{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fateradar.cn/contracts/views/hecan-view-v1.schema.json", "title": "Hecan ViewModel v1",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "subject_ref", "selected_art_ids", "dimensions"],
  "properties": {"schema_version": {"const": "hecan-view/v1"}, "subject_ref": {"type": "string", "minLength": 1}, "selected_art_ids": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["bazi", "ziwei", "qizheng"]}}, "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}}},
  "$defs": {
    "signal": {"type": "object", "additionalProperties": false, "required": ["art_id", "subject_refs", "signal_id", "display_text", "fact_refs"], "properties": {"art_id": {"enum": ["bazi", "ziwei", "qizheng", "liuyao", "qimen", "daliuren"]}, "subject_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "signal_id": {"type": "string", "minLength": 1}, "display_text": {"type": "string", "minLength": 1}, "fact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "comparisonRow": {"type": "object", "additionalProperties": false, "required": ["arts", "kind", "display_text", "fact_refs", "source_rule_id"], "properties": {"arts": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["bazi", "ziwei", "qizheng", "liuyao", "qimen", "daliuren"]}}, "kind": {"enum": ["source_bound_corroboration", "source_disagreement_retained", "missing_art", "insufficient_arts"]}, "display_text": {"type": "string", "minLength": 1}, "signal_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "fact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "source_rule_id": {"type": "string", "minLength": 1}}},
    "dimension": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "signals", "convergence", "disagreements", "missing_art_ids"], "properties": {"dimension_id": {"type": "string", "minLength": 1}, "signals": {"type": "array", "items": {"$ref": "#/$defs/signal"}}, "convergence": {"type": "array", "items": {"$ref": "#/$defs/comparisonRow"}}, "disagreements": {"type": "array", "items": {"$ref": "#/$defs/comparisonRow"}}, "missing_art_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  }
}
