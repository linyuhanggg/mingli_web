{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fateradar.cn/contracts/views/physiognomy-view-v1.schema.json", "title": "Physiognomy ViewModel v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "subject_ref", "mode", "observations", "missing_targets", "uncertainties", "conflicts", "cross_capture_variations", "source_comparison", "active_source_rule_ids"],
  "properties": {
    "schema_version": {"const": "physiognomy-view/v1"}, "subject_ref": {"type": "string", "minLength": 1}, "mode": {"enum": ["face", "palm", "posture", "combined"]},
    "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observation_id", "region_id", "feature_id", "confidence", "display_text"], "properties": {"observation_id": {"type": "string", "minLength": 1}, "region_id": {"type": "string", "minLength": 1}, "feature_id": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "display_text": {"type": "string", "minLength": 1}}}},
    "missing_targets": {"type": "array", "items": {"type": "object"}},
    "uncertainties": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "cross_capture_variations": {"type": "array", "items": {"type": "object"}},
    "source_comparison": {"type": "object", "additionalProperties": false, "required": ["sources", "disagreements_retained", "disagreements", "forced_resolution"], "properties": {"sources": {"type": "array", "items": {"type": "object"}}, "disagreements_retained": {"type": "boolean"}, "disagreements": {"type": "array", "items": {"type": "object"}}, "forced_resolution": {"type": "boolean"}}},
    "active_source_rule_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
