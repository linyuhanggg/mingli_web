{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fateradar.cn/contracts/bazi-chart-sync-v1.schema.json",
  "title": "Bazi Chart Sync Response v1",
  "oneOf": [
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/needInput" }
  ],
  "$defs": {
    "profileVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "factPanel": {
      "type": "object",
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "value"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "value": {}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "inputChoice": {
      "type": "object",
      "required": ["id", "label", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "inputField": {
      "type": "object",
      "required": ["id", "label", "type_id", "description", "choices"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "type_id": {
          "type": "string",
          "enum": ["integer", "text", "textarea", "choice"]
        },
        "description": { "type": ["string", "null"] },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputChoice" }
        }
      },
      "additionalProperties": false
    },
    "inputRequirement": {
      "type": "object",
      "required": ["any_of"],
      "properties": {
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inputField" }
        }
      },
      "additionalProperties": false
    },
    "inputRequest": {
      "type": "object",
      "required": ["requirements"],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inputRequirement" }
        }
      },
      "additionalProperties": false
    },
    "ready": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version_id",
        "status",
        "chart_handle",
        "fact_panel",
        "input_request"
      ],
      "properties": {
        "profile_version_id": { "$ref": "#/$defs/profileVersionId" },
        "status": { "const": "ready" },
        "chart_handle": { "type": "null" },
        "fact_panel": { "$ref": "#/$defs/factPanel" },
        "input_request": { "type": "null" }
      }
    },
    "needInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_version_id",
        "status",
        "chart_handle",
        "fact_panel",
        "input_request"
      ],
      "properties": {
        "profile_version_id": { "$ref": "#/$defs/profileVersionId" },
        "status": { "const": "need_input" },
        "chart_handle": { "type": "string", "minLength": 1 },
        "fact_panel": { "type": "null" },
        "input_request": { "$ref": "#/$defs/inputRequest" }
      }
    }
  }
}
