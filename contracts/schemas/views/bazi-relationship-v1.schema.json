{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://fateradar.cn/contracts/views/bazi-relationship-v1.schema.json", "title": "Bazi Relationship ViewModel v1",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "subjects", "relationship_type", "signals"],
  "properties": {"schema_version": {"const": "bazi-relationship/v1"}, "subjects": {"$ref": "#/$defs/subjects"}, "relationship_type": {"$ref": "#/$defs/relationshipType"}, "signals": {"$ref": "#/$defs/signals"}},
  "$defs": {
    "subjects": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["subject_ref", "profile_version_id", "label"], "properties": {"subject_ref": {"type": "string", "minLength": 1}, "profile_version_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}}},
    "relationshipType": {"enum": ["romantic", "married", "parent_child", "business", "work", "friend"]},
    "signals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "subject_refs", "signal_id", "display_text", "fact_refs"], "properties": {"dimension_id": {"type": "string", "minLength": 1}, "subject_refs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "minLength": 1}}, "signal_id": {"type": "string", "minLength": 1}, "display_text": {"type": "string", "minLength": 1}, "fact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}}}
  }
}
