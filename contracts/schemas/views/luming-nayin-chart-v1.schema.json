{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fateradar.cn/contracts/views/luming-nayin-chart-v1.schema.json",
  "title": "LumingNayinChartV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_ref", "pillars", "three_yuan_profiles", "taiyuan", "relations", "source_conditioned_patterns"],
  "properties": {
    "schema_version": {"const": "luming-nayin-chart/v1"},
    "subject_ref": {"type": "string", "minLength": 1},
    "pillars": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/pillar"}},
    "three_yuan_profiles": {"type": "object"},
    "taiyuan": {"oneOf": [{"type": "object"}, {"type": "null"}]},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "source_conditioned_patterns": {"type": "array", "items": {"$ref": "#/$defs/sourcePattern"}}
  },
  "$defs": {
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "stem", "branch", "nayin"],
      "properties": {
        "position": {"enum": ["year", "month", "day", "hour"]},
        "stem": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "nayin": {"type": "string", "minLength": 1}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "relation", "anchor", "anchor_pillar", "status", "target_branch", "candidates", "matched_positions", "recension"],
      "properties": {
        "category": {"enum": ["lu", "ma", "gui"]},
        "relation": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1},
        "anchor_pillar": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "target_branch": {"type": ["string", "null"], "minLength": 1},
        "candidates": {"type": "array", "items": {"type": "string"}},
        "matched_positions": {"type": "array", "items": {"type": "string"}},
        "recension": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "sourcePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "local_rule_id", "title", "source_pack", "source_anchor", "status", "fact_paths", "predicate_audit", "applicability_adjudication"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "local_rule_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_pack": {"type": "string", "minLength": 1},
        "source_anchor": {"type": "string", "minLength": 1},
        "status": {"const": "predicate_matched_not_verdict"},
        "fact_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "predicate_audit": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "applicability_adjudication": {"$ref": "#/$defs/ruleApplicabilityAdjudication"}
      }
    },
    "ruleSourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack", "rule_id", "source_anchor", "verification_status", "binding_digest"],
      "properties": {
        "pack": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "source_anchor": {"type": "string", "minLength": 1},
        "verification_status": {"const": "verified"},
        "binding_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ruleApplicabilityAdjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision_scope", "rule_id", "local_rule_id", "rule_title", "evidence_role", "hard_verdict", "life_verdict", "source_ref", "unresolved_checks"],
      "properties": {
        "status": {"const": "adjudicated_rule_applicability"},
        "decision_scope": {"const": "luming_nayin_source_rule_applicability"},
        "rule_id": {"type": "string", "minLength": 1},
        "local_rule_id": {"type": "string", "minLength": 1},
        "rule_title": {"type": "string", "minLength": 1},
        "evidence_role": {"enum": ["issue_specific_judgment_rule", "methodology_rule"]},
        "hard_verdict": {"type": "null"},
        "life_verdict": {"type": "null"},
        "source_ref": {"$ref": "#/$defs/ruleSourceRef"},
        "unresolved_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
