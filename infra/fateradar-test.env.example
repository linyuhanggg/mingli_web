# FateRadar code-test environment (single Ubuntu host).
# All values in this file are FAKE / PLACEHOLDER. Never put real credentials here.
#
# Deploy:
#   install -o root -g root -m 600 \
#     infra/fateradar-test.env.example /etc/fateradar/test.env
#   # then edit /etc/fateradar/test.env and replace every PLACEHOLDER value.
#
# The API and Worker units share this file via
# EnvironmentFile=/etc/fateradar/test.env. The Web unit does not use it:
# web/next.config.ts inlines BACKEND_INTERNAL_URL at build time.

# Code-test contract: local mode keeps the fake adapters legal.
MINGLI_ENVIRONMENT=local
MINGLI_LOG_LEVEL=INFO

# PostgreSQL on the same host (TCP 127.0.0.1). Replace the password placeholder
# before any real traffic; the DB user must own the fateradar_test database.
MINGLI_DATABASE_URL=postgresql+asyncpg://fateradar_test:PLACEHOLDER_DB_PASSWORD_CHANGE_ME@127.0.0.1:5432/fateradar_test

# Only loopback proxies may rewrite X-Forwarded-For.
MINGLI_TRUSTED_PROXY_CIDRS=127.0.0.0/8

# Loopback runs plain HTTP, so cookies must not be Secure.
MINGLI_COOKIE_SECURE=false

# Default code-test adapters stay fake. Dogfood overrides (do not commit secrets):
#   MINGLI_OTP_ADAPTER=smtp
#   MINGLI_SMTP_HOST=...
#   MINGLI_SMTP_PORT=587
#   MINGLI_SMTP_SECURITY=starttls
#   MINGLI_SMTP_SENDER=...
#   MINGLI_SMTP_USERNAME=...
#   MINGLI_SMTP_PASSWORD=...
#   MINGLI_RUNTIME_ADAPTER=one-shot
#   MINGLI_MODEL_ADAPTER=deepseek
#   DEEPSEEK_API_KEY=...
#   MINGLI_DOGFOOD_ENTITLEMENT_GATES_ENABLED=true
#   MINGLI_DOGFOOD_DAILY_READING_LIMIT=10
#   MINGLI_DOGFOOD_DAILY_PAID_READING_LIMIT=6
# Fake OTP accepts the fixed code 246810 and only echoes it in local/test responses.
MINGLI_OTP_ADAPTER=fake
MINGLI_FAKE_OTP_CODE=246810
MINGLI_RUNTIME_ADAPTER=fake
MINGLI_MODEL_ADAPTER=fake

# Dogfood gates default off in this example (unit tests / bare code-test).
# Enable on the dogfood host after SMTP + one-shot + deepseek are configured.
MINGLI_DOGFOOD_ENTITLEMENT_GATES_ENABLED=false
MINGLI_DOGFOOD_DAILY_READING_LIMIT=10
MINGLI_DOGFOOD_DAILY_PAID_READING_LIMIT=6

# Identity hash key: obvious placeholder, replace with a random secret.
MINGLI_IDENTITY_HASH_KEY=PLACEHOLDER_IDENTITY_HASH_KEY_CHANGE_ME

# Content encryption key: base64 encoding of exactly 32 bytes (required by
# backend/app/config.py). The value below is the base64 of the plain placeholder
# string "0123456789abcdef0123456789abcdef" -- replace it before real use.
MINGLI_CONTENT_ENCRYPTION_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
MINGLI_CONTENT_ENCRYPTION_KEY_ID=test-placeholder-content-v1

# DeepSeek is intentionally not configured while MINGLI_MODEL_ADAPTER=fake.
# For dogfood, inject DEEPSEEK_API_KEY only via the server env file, never Git.
